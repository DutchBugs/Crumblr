# Copy to `.env` and fill in locally. `.env` is git-ignored and must stay that way.
#
# build.md §21: MT5 credentials live in a secret store (Windows Credential
# Manager, Vault, or a cloud secret manager) and are read only by the MT5
# gateway process. This file exists so a developer can run the gateway on a
# workstation — it is not the production mechanism.
#
# The Trading Agent and the Evaluator never receive these values.

# --- MT5 gateway (Windows host only) ---------------------------------------
CRUMBLR_MT5_LOGIN=
CRUMBLR_MT5_PASSWORD=
CRUMBLR_MT5_SERVER=
CRUMBLR_MT5_TERMINAL_PATH=

# --- Platform ---------------------------------------------------------------
# One of: backtest, replay, paper, shadow, live
CRUMBLR_ENVIRONMENT=paper

# Loading a live configuration additionally requires this to be exactly "1".
# Leave empty. Setting it is a deliberate, recorded promotion decision.
CRUMBLR_ALLOW_LIVE=

# --- Database ---------------------------------------------------------------
# Read from the environment rather than from config/, because a URL carries
# credentials and build.md §21 keeps those out of the repository.
# The local development container in README.md publishes 55432, deliberately
# off the default port so it cannot collide with a PostgreSQL already running.
CRUMBLR_DATABASE_URL=postgresql+psycopg://crumblr:crumblr@localhost:55432/crumblr
